LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.tokenrouter.com/v1
LLM_MODEL=qwen/qwen3.8-max-free

# Optional: absolute path to an existing git repo the Filesystem/Git official
# MCP servers should operate on. Must already be `git init`-ed with a git
# identity configured. Defaults to client-host/workspace if unset.
MCP_WORKSPACE_DIR=/absolute/path/to/your/reports-repo
